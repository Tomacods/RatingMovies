# Configuracion web: Firebase > Configuracion del proyecto > Tus apps.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Servidor: nunca usar prefijo PUBLIC_ para estas variables.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_UID=
# Desarrollo local: ruta absoluta al JSON fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=
# Vercel: contenido del JSON como secreto, en una sola linea; dejar vacio en local.
FIREBASE_SERVICE_ACCOUNT_JSON=
# TMDB: credenciales exclusivas del servidor. Se recomienda el Read Access Token.
TMDB_READ_ACCESS_TOKEN=
# Alternativa si solo se dispone de la API Key v3.
TMDB_API_KEY=
