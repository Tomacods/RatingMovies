---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Icon from '../components/Icon.astro';
import { demoTitles } from '../data/demo';
const backdrop = demoTitles[0]?.backdrop;
---

<BaseLayout title="Ingresar" description="Vista de diseño del acceso privado de administración de RatingMovies.">
  <SiteHeader active="ingresar" overlay />
  <main id="contenido" class="login-page">
    {backdrop && <img class="login-backdrop" src={backdrop} alt="" />}
    <div class="login-shade"></div>
    <div class="page-shell login-composition">
      <div class="login-intro"><h1>Una historia.<br />Tu impresión.</h1><p>El catálogo está abierto a todos.<br />Este espacio está reservado a quien lo mantiene.</p><a href="/catalogo/" class="back-to-catalog"><Icon name="arrow-left" />Explorar el catálogo</a></div>
      <section class="login-form-area" aria-labelledby="login-title">
        <Icon name="lock" /><h2 id="login-title">Ingresar</h2><p class="login-description">Acceso de administrador</p>
        <p class="demo-notice" id="login-design-notice">Vista de diseño. El acceso se habilitará al conectar la autenticación.</p>
        <form aria-describedby="login-design-notice">
          <fieldset disabled><legend class="sr-only">Formulario de acceso deshabilitado</legend><label for="email">Correo electrónico</label><input id="email" type="email" placeholder="tu-correo@ejemplo.com" autocomplete="off" disabled /><label for="password">Contraseña</label><input id="password" type="password" placeholder="No disponible en esta vista" autocomplete="off" disabled /><button class="button button--primary login-submit" type="button" disabled>Ingresar<Icon name="arrow-right" /></button></fieldset>
        </form>
        <p class="credentials-note">Este boceto no recibe credenciales ni inicia una sesión.</p>
        <a class="form-preview-link" href="/diseno/formulario/">Ver boceto del formulario<Icon name="arrow-right" /></a>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .login-page { position:relative; min-height:100svh; display:flex; align-items:center; isolation:isolate; background:var(--color-bg); }
  .login-backdrop,.login-shade { position:absolute; inset:0; width:100%; height:100%; z-index:-1; }
  .login-backdrop { object-fit:cover; object-position:40% center; opacity:.6; }
  .login-shade { background:linear-gradient(90deg,#0a0a0a6b 0%,#0a0a0a9c 44%,#0a0a0afa 76%),linear-gradient(0deg,#0a0a0a 0%,transparent 42%,#0a0a0a6b 100%); }
  .login-composition { width:100%; display:grid; grid-template-columns:minmax(0,1fr) 410px; gap:100px; align-items:center; padding-top:145px; padding-bottom:75px; }
  .login-intro h1 { margin:0; font-family:var(--font-display); font-size:clamp(4rem,6.8vw,6rem); font-weight:500; line-height:1.04; letter-spacing:-.035em; }
  .login-intro>p { margin:26px 0 33px; color:#dedee0; font-size:16px; line-height:1.85; }
  .back-to-catalog { display:inline-flex; gap:11px; align-items:center; color:var(--color-text); font-size:14px; text-decoration:none; }
  .back-to-catalog :global(svg) { width:18px; height:18px; }
  .back-to-catalog:hover { text-decoration:underline; text-underline-offset:5px; }
  .login-form-area { padding:0 0 0 3px; }
  .login-form-area>:global(svg) { width:25px; height:25px; margin-bottom:19px; color:var(--color-muted); }
  h2 { margin:0; font-family:var(--font-display); font-size:46px; font-weight:500; line-height:1.1; letter-spacing:-.025em; }
  .login-description { margin:10px 0 24px; color:var(--color-muted); font-size:14px; }
  .login-form-area .demo-notice { margin:0 0 28px; font-size:12px; line-height:1.8; }
  fieldset { margin:0; padding:0; border:0; min-width:0; }
  label { display:block; font-size:13px; margin-bottom:9px; }
  input { display:block; width:100%; min-height:49px; padding:13px 14px; margin-bottom:22px; border:1px solid #ffffff4f; border-radius:2px; background:#121316d9; color:var(--color-muted); font:inherit; font-size:14px; }
  input::placeholder { color:#9d9fa8; opacity:1; }
  input:disabled { cursor:not-allowed; opacity:1; }
  .login-submit { display:flex; width:100%; justify-content:space-between; min-height:49px; margin-top:6px; }
  .login-submit:disabled { cursor:not-allowed; opacity:.48; }
  .login-submit :global(svg) { width:18px; height:18px; }
  .credentials-note { margin:15px 0 0; color:var(--color-muted); font-size:12px; line-height:1.8; }
  .form-preview-link { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-top:31px; padding-top:20px; border-top:1px solid var(--color-line); color:var(--color-text); text-decoration:none; font-size:13px; }
  .form-preview-link :global(svg) { width:17px; height:17px; }
  .form-preview-link:hover { text-decoration:underline; text-underline-offset:5px; }
  @media(max-width:1000px) { .login-composition { gap:50px; grid-template-columns:minmax(0,1fr) 370px; } .login-intro h1 { font-size:72px; } }
  @media(max-width:720px) { .login-page { align-items:flex-start; } .login-composition { grid-template-columns:1fr; gap:43px; padding-top:125px; padding-bottom:52px; } .login-backdrop { height:450px; object-position:45% 30%; opacity:.45; } .login-shade { background:linear-gradient(0deg,var(--color-bg) 45%,#0a0a0a75 100%); } .login-intro h1 { font-size:57px; } .login-intro>p { margin:20px 0 23px; font-size:14px; line-height:1.8; } .back-to-catalog { font-size:13px; } .login-form-area { padding:27px 0 0; border-top:1px solid var(--color-line); } .login-form-area>:global(svg) { display:none; } h2 { font-size:39px; } .login-description { margin-bottom:21px; } .login-form-area .demo-notice { margin-bottom:23px; } }
</style>
