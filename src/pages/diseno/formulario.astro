---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Icon from '../../components/Icon.astro';
import { demoTitles } from '../../data/demo';
const entry = demoTitles[0];
const platforms = [...new Set(demoTitles.map((title) => title.platform))];
---

<BaseLayout title="Boceto del formulario" description="Composición visual del formulario para registrar una película o serie. Los campos están deshabilitados.">
  <SiteHeader active="ingresar" />
  <main id="contenido" class="page-shell form-page">
    <a class="back-link" href="/ingresar/"><Icon name="arrow-left" />Volver a la vista de acceso</a>
    <header class="form-heading"><h1>Agregar un título.</h1><p>Una ficha para la obra. Un lugar para tu valoración.</p></header>
    <p class="demo-notice" id="form-design-notice">Boceto · datos de ejemplo. Los campos y el guardado están deshabilitados; esta página permite revisar la composición.</p>

    <form class="title-form" aria-describedby="form-design-notice">
      <fieldset disabled><legend class="sr-only">Formulario de ejemplo deshabilitado</legend>
        <div class="form-composition">
          <section class="cover-column" aria-labelledby="cover-title"><h2 id="cover-title">Portada</h2><div class="cover-preview"><img src={entry.poster} alt={`Portada de ejemplo de ${entry.title}`} width="400" height="600" /><span>Imagen de ejemplo</span></div><label for="cover-file" class="file-label">Cargar una portada</label><input id="cover-file" type="file" accept="image/jpeg,image/png,image/webp" disabled /><p class="field-help">La carga de archivos se habilitará al conectar el almacenamiento.</p></section>
          <div class="fields-column">
            <section aria-labelledby="work-fields-title"><h2 id="work-fields-title">La obra</h2><div class="fields-grid"><div class="field full-width"><label for="title-name">Nombre</label><input id="title-name" type="text" value={entry.title} disabled /></div><div class="field"><label for="title-type">Tipo</label><select id="title-type" disabled><option value="movie" selected={entry.kind === 'movie'}>Película</option><option value="tv" selected={entry.kind === 'tv'}>Serie</option></select></div><div class="field"><label for="runtime">Duración</label><input id="runtime" type="text" value={entry.runtime} disabled /><p class="field-help">En películas, duración total. En series, por episodio.</p></div></div></section>
            <section class="viewing-fields" aria-labelledby="viewing-fields-title"><h2 id="viewing-fields-title">La experiencia</h2><div class="fields-grid"><div class="field"><label for="rating">Valoración personal</label><div class="rating-input"><input id="rating" type="number" min="1" max="10" step="1" value={entry.score} disabled /><span>/10</span></div><p class="field-help">Del 1 al 10, solo números enteros.</p></div><div class="field"><label for="watched-date">Fecha de visualización</label><input id="watched-date" type="date" value={entry.watchedOn} disabled /></div><div class="field full-width"><label for="platform">Plataforma donde la viste</label><select id="platform" disabled>{platforms.map((platform) => <option selected={platform === entry.platform}>{platform}</option>)}</select><p class="field-help">Representa dónde la viste, aunque después cambie su disponibilidad.</p></div><div class="field full-width"><label for="personal-note">Nota personal <span class="optional">Opcional</span></label><textarea id="personal-note" rows="4" disabled>{entry.note}</textarea></div></div></section>
            <div class="form-actions"><button class="button button--primary" type="button" disabled>Guardar título<Icon name="check" /></button><p>Vista de diseño · sin guardado</p></div>
          </div>
        </div>
      </fieldset>
    </form>
  </main>
</BaseLayout>

<style>
  .form-page { max-width:1160px; padding-top:31px; padding-bottom:72px; }
  .back-link { display:inline-flex; align-items:center; gap:9px; padding:7px 0; color:var(--color-muted); font-size:13px; text-decoration:none; }
  .back-link :global(svg) { width:17px; height:17px; }
  .back-link:hover { color:var(--color-text); text-decoration:underline; text-underline-offset:5px; }
  .form-heading { margin:30px 0 22px; }
  h1 { margin:0; font-family:var(--font-display); font-size:clamp(3.1rem,6vw,5rem); line-height:1.04; font-weight:500; letter-spacing:-.03em; }
  .form-heading>p { margin:18px 0 0; color:var(--color-muted); font-size:15px; line-height:1.8; }
  .form-page>.demo-notice { max-width:79ch; margin:0 0 39px; font-size:12px; line-height:1.8; }
  fieldset { min-width:0; margin:0; padding:0; border:0; }
  .form-composition { display:grid; grid-template-columns:240px minmax(0,1fr); gap:65px; }
  h2 { margin:0 0 23px; font-family:var(--font-display); font-size:28px; font-weight:500; line-height:1.1; letter-spacing:-.02em; }
  .cover-preview { position:relative; aspect-ratio:2/3; background:var(--color-raised); }
  .cover-preview img { display:block; width:100%; height:100%; object-fit:cover; }
  .cover-preview>span { position:absolute; bottom:10px; left:10px; right:10px; padding:7px 9px; color:var(--color-text); background:#0a0a0ae6; font-size:11px; text-align:center; }
  .file-label { margin-top:20px; }
  .cover-column input { width:100%; padding:10px 8px; font-size:11px; }
  .cover-column input::file-selector-button { margin-right:6px; padding:6px; border:1px solid #ffffff45; border-radius:0; color:var(--color-muted); background:var(--color-raised); font:inherit; }
  .fields-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:23px 22px; }
  .field { min-width:0; }
  .full-width { grid-column:1/-1; }
  label { display:block; margin-bottom:9px; color:var(--color-text); font-size:13px; }
  input,select,textarea { min-width:0; width:100%; border:1px solid #ffffff40; border-radius:2px; padding:12px 13px; background:var(--color-surface); color:#c6c7cc; font:inherit; font-size:14px; line-height:1.5; }
  input,select { min-height:47px; }
  input:disabled,select:disabled,textarea:disabled { opacity:1; cursor:not-allowed; -webkit-text-fill-color:#c6c7cc; }
  textarea { display:block; resize:none; }
  .field-help { color:var(--color-muted); font-size:11px; line-height:1.8; margin:8px 0 0; }
  .viewing-fields { margin-top:37px; padding-top:31px; border-top:1px solid var(--color-line); }
  .rating-input { position:relative; }
  .rating-input input { padding-right:48px; }
  .rating-input span { position:absolute; right:14px; top:14px; color:var(--color-muted); font-size:13px; font-variant-numeric:tabular-nums; }
  .optional { float:right; color:var(--color-muted); font-size:11px; }
  .form-actions { display:flex; align-items:center; gap:20px; margin-top:28px; padding-top:25px; border-top:1px solid var(--color-line); }
  .form-actions button { display:inline-flex; justify-content:space-between; align-items:center; gap:30px; min-height:46px; opacity:.46; cursor:not-allowed; }
  .form-actions button :global(svg) { width:17px; height:17px; }
  .form-actions p { margin:0; color:var(--color-muted); font-size:11px; line-height:1.7; }
  @media(max-width:800px) { .form-composition { grid-template-columns:190px minmax(0,1fr); gap:32px; } }
  @media(max-width:600px) { .form-page { padding-top:21px; padding-bottom:48px; } .form-heading { margin-top:24px; } .form-heading>p { max-width:28ch; font-size:14px; margin-top:16px; } .form-page>.demo-notice { margin-bottom:30px; } .form-composition { grid-template-columns:1fr; gap:34px; } .cover-column { display:grid; grid-template-columns:110px minmax(0,1fr); column-gap:20px; align-items:start; } .cover-column h2 { grid-column:1/-1; margin-bottom:17px; } .cover-preview { grid-column:1; grid-row:2/5; } .cover-preview>span { left:5px; right:5px; bottom:5px; font-size:9px; padding:4px; } .file-label { grid-column:2; margin-top:3px; } .cover-column input { grid-column:2; padding:7px 5px; font-size:10px; min-height:43px; } .cover-column .field-help { grid-column:2; margin-top:8px; font-size:10px; } h2 { font-size:26px; margin-bottom:20px; } .fields-grid { gap:20px 15px; } .viewing-fields { margin-top:28px; padding-top:26px; } label { font-size:12px; } input,select,textarea { font-size:13px; padding:11px 10px; } .field-help { font-size:10px; } .form-actions { align-items:flex-start; flex-direction:column; gap:12px; } .form-actions button { width:100%; } }
</style>
