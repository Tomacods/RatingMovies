---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Icon from '../../components/Icon.astro';
import { formatWatchedDate, kindLabel } from '../../lib/title';
import { getTitle } from '../../lib/server/catalog';
const entry = await getTitle(Astro.params.slug);
if (!entry) return Astro.redirect('/404');
---

<BaseLayout title={entry.title} description={`Ficha de ${entry.title}, con valoración y fecha de visualización.`}>
  <SiteHeader active="catalogo" overlay />
  <main id="contenido">
    <section class="detail-hero" aria-labelledby="title-name">
      <img class="detail-backdrop" src={entry.backdrop} alt="" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="page-shell hero-content">
        <a class="back-link" href="/catalogo/"><Icon name="arrow-left" />Volver al catálogo</a>
        <div class="detail-composition">
          <div class="title-copy"><h1 id="title-name">{entry.title}</h1><p class="title-meta"><span>{entry.year}</span><span>{kindLabel(entry.kind)}</span><span>{entry.runtime}</span><span>{entry.genre}</span></p><div class="watch-line"><span class="detail-score"><Icon name="star" /><strong>{entry.score}</strong><span>/10</span></span><p>Vista el {formatWatchedDate(entry.watchedOn)}<span>En {entry.platform}</span></p></div>{Astro.locals.isAdmin && <a class="button" href={`/administrar/${entry.slug}`}>Editar título</a>}</div>
          <img class="detail-poster" src={entry.poster} alt={`Portada de ${entry.title}`} width="400" height="600" />
        </div>
      </div>
    </section>
    <div class="page-shell detail-reading">
      <div class="reading-main"><section aria-labelledby="summary-title"><h2 id="summary-title">La historia</h2><p>{entry.summary || "Todavía no hay una sinopsis para este título."}</p></section><section class="personal-note" aria-labelledby="note-title"><h2 id="note-title">Mi impresión</h2><blockquote>{entry.note || "Por ahora, mi impresión está en la valoración."}</blockquote></section></div>
      <aside class="title-facts" aria-label="Datos de la ficha"><h2>La ficha</h2><dl><div><dt>Título original</dt><dd>{entry.originalTitle}</dd></div><div><dt>Tipo</dt><dd>{kindLabel(entry.kind)}</dd></div><div><dt>{entry.kind === 'tv' ? 'Duración por episodio' : 'Duración'}</dt><dd>{entry.runtime}</dd></div><div><dt>Género</dt><dd>{entry.genre}</dd></div><div><dt>Fecha de visualización</dt><dd>{formatWatchedDate(entry.watchedOn)}</dd></div><div><dt>Plataforma elegida</dt><dd>{entry.platform}</dd></div></dl></aside>
    </div>
  </main>
</BaseLayout>

<style>
  .detail-hero { min-height:740px; position:relative; display:flex; align-items:flex-end; background:var(--color-surface); isolation:isolate; }
  .detail-backdrop,.hero-shade { position:absolute; inset:0; width:100%; height:100%; z-index:-1; }
  .detail-backdrop { object-fit:cover; object-position:center 35%; }
  .hero-shade { background:linear-gradient(0deg,var(--color-bg) 0%,#0a0a0ade 12%,#0a0a0a5c 70%,#0a0a0a83 100%); }
  .hero-content { width:100%; padding-top:132px; padding-bottom:52px; }
  .back-link { display:inline-flex; align-items:center; gap:9px; color:var(--color-text); font-size:14px; text-decoration:none; padding:8px 0; }
  .back-link :global(svg) { width:18px; height:18px; }
  .back-link:hover { text-decoration:underline; text-underline-offset:5px; }
  .detail-composition { display:grid; grid-template-columns:minmax(0,1fr) 190px; align-items:end; gap:64px; margin-top:75px; }
  .title-copy { max-width:900px; }
  h1 { margin:0; font-family:var(--font-display); font-size:clamp(4rem,7.7vw,6rem); line-height:1.04; font-weight:500; letter-spacing:-.035em; text-wrap:balance; }
  .title-meta { display:flex; flex-wrap:wrap; gap:8px 20px; margin:22px 0 0; font-size:14px; color:#dedfdf; }
  .watch-line { display:flex; align-items:center; gap:24px; margin-top:27px; }
  .detail-score { display:flex; align-items:baseline; gap:5px; font-variant-numeric:tabular-nums; }
  .detail-score :global(svg) { align-self:center; width:22px; height:22px; margin-right:7px; }
  .detail-score strong { font-family:var(--font-display); font-size:54px; line-height:1; font-weight:500; }
  .detail-score>span { color:var(--color-muted); font-size:17px; }
  .watch-line p { margin:0; font-size:13px; color:#e0e0e0; line-height:1.7; }
  .watch-line p span { display:block; color:var(--color-muted); }
  .title-copy .demo-notice { display:inline-flex; margin:26px 0 0; }
  .detail-poster { display:block; width:190px; height:285px; object-fit:cover; border:1px solid var(--color-line); }
  .detail-reading { display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:90px; padding-top:45px; padding-bottom:90px; }
  .detail-reading h2 { margin:0 0 20px; font-family:var(--font-display); font-size:33px; line-height:1.1; font-weight:500; letter-spacing:-.02em; }
  .reading-main section>p { max-width:68ch; color:var(--color-muted); font-size:16px; line-height:1.9; }
  .personal-note { margin-top:48px; padding-top:35px; border-top:1px solid var(--color-line); }
  blockquote { margin:0; max-width:38ch; font-size:24px; line-height:1.6; font-weight:400; letter-spacing:-.02em; }
  .reading-main .example-explanation { margin-top:19px; font-size:13px; line-height:1.8; }
  .title-facts { border-top:1px solid var(--color-line); padding-top:26px; }
  .title-facts h2 { font-size:27px; }
  dl { margin:0; }
  dl div { padding:12px 0; }
  dt { color:var(--color-muted); font-size:12px; margin-bottom:5px; }
  dd { margin:0; font-size:14px; line-height:1.7; }
  @media(max-width:900px) { .detail-composition { gap:28px; } .detail-reading { gap:44px; grid-template-columns:minmax(0,1fr) 230px; } }
  @media(max-width:600px) { .detail-hero { min-height:690px; } .detail-backdrop { object-position:56% 30%; } .hero-content { padding-top:116px; padding-bottom:33px; } .detail-composition { grid-template-columns:1fr; gap:0; margin-top:110px; } h1 { font-size:clamp(3.2rem,14vw,4.2rem); } .detail-poster { display:none; } .title-meta { gap:7px 14px; margin-top:19px; font-size:12px; } .watch-line { gap:20px; margin-top:23px; } .detail-score strong { font-size:46px; } .watch-line p { font-size:12px; } .title-copy .demo-notice { margin-top:23px; font-size:11px; } .detail-reading { grid-template-columns:1fr; gap:44px; padding-top:27px; padding-bottom:55px; } .detail-reading h2 { font-size:30px; margin-bottom:15px; } .reading-main section>p { font-size:15px; line-height:1.85; } .personal-note { margin-top:34px; padding-top:28px; } blockquote { font-size:21px; line-height:1.65; } .title-facts dl { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2px 22px; } .title-facts h2 { font-size:27px; } }
</style>
