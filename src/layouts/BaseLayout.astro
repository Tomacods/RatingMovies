---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'RatingMovies', description = 'Un catálogo personal de películas, series y recuerdos después de los créditos.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/oswald-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title === 'RatingMovies' ? title : title + ' · RatingMovies'}</title>
  </head>
  <body><a class="skip-link" href="#contenido">Saltar al contenido</a><slot /></body>
</html>
